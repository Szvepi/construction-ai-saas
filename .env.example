# --- App URLs (production) ---
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
ACME_EMAIL=you@example.com
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_DB=buildassist
POSTGRES_USER=buildassist
POSTGRES_PASSWORD=Password123!
# Host port (local dev: backend on host → localhost:POSTGRES_PORT)
POSTGRES_PORT=5432
# Local Spring Boot: use localhost. Docker app service overrides to postgres:5432.
DATABASE_URL=jdbc:postgresql://localhost:5432/buildassist
DATABASE_USERNAME=buildassist
DATABASE_PASSWORD=Password123!

# --- Redis (sessions) ---
# Local Spring Boot: use localhost. Docker app service overrides to redis.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT (min 32 bytes for HS256) ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- AES-256 token encryption (exactly 32 bytes) ---
TOKEN_ENCRYPTION_KEY=01234567890123456789012345678901

# --- Gmail OAuth 2.0 (legacy manual flow - keep for backwards compatibility) ---
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:8080/api/gmail/callback

# --- Google OAuth2 (Spring Security login) ---
# Get from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# --- OpenAI ---
OPENAI_API_KEY=sk-ant-your-key-here

# --- Server ---
SERVER_PORT=8080
