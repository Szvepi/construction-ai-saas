# --- App URLs (production) ---
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
ACME_EMAIL=you@example.com
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_DB=mira_dev
POSTGRES_USER=buildassist
POSTGRES_PASSWORD=Password123!
# Host port (local dev: backend on host → localhost:POSTGRES_PORT)
POSTGRES_PORT=5432
# Local Spring Boot: use localhost. Docker app service overrides to postgres:5432.
DATABASE_URL=jdbc:postgresql://localhost:5432/mira_dev
DATABASE_USERNAME=buildassist
DATABASE_PASSWORD=Password123!

# --- Redis (sessions) ---
# Local Spring Boot: use localhost. Docker app service overrides to redis.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT (min 32 bytes for HS256) ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- AES-256 token encryption (exactly 32 bytes) ---
TOKEN_ENCRYPTION_KEY=

# --- Gmail OAuth 2.0 (legacy manual flow - keep for backwards compatibility) ---
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:8080/api/gmail/callback
GMAIL_SYNC_WINDOW_MONTHS=6
# Set the limits to the Gmail API quotas configured for this Cloud project.
GMAIL_QUOTA_PROJECT_KEY=default
GMAIL_PROJECT_QUOTA_UNITS_PER_MINUTE=1200000
GMAIL_USER_QUOTA_UNITS_PER_MINUTE=6000
GMAIL_QUOTA_SAFETY_MARGIN=0.2
GMAIL_MAX_CONCURRENT_REQUESTS_PER_ACCOUNT=1
GMAIL_SYNC_POLL_INTERVAL_MS=30000
GMAIL_RETRY_BASE_DELAY_SECONDS=5
GMAIL_RETRY_MAX_DELAY_SECONDS=900
GMAIL_RETRY_MAX_ATTEMPTS=8
GMAIL_LIST_QUOTA_UNITS=5
GMAIL_GET_METADATA_QUOTA_UNITS=20
GMAIL_GET_FULL_QUOTA_UNITS=60
GMAIL_HISTORY_QUOTA_UNITS=2
GMAIL_PROFILE_QUOTA_UNITS=1
GMAIL_DRAFT_CREATE_QUOTA_UNITS=10

# --- Google OAuth2 (Spring Security login) ---
# Get from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# --- OpenAI ---
OPENAI_API_KEY=sk-ant-your-key-here

# --- Server ---
SERVER_PORT=8080
